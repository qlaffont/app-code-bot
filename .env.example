# Slack app "AppCode" (deploy/slack-app-manifest.yaml)
# OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information → App-Level Tokens, scope connections:write
SLACK_APP_TOKEN=xapp-...
# Channel id (C…) for alerts, e.g. when the T3 token can't be renewed. Invite the bot there.
SLACK_ADMIN_CHANNEL=

# T3 server on this machine
T3_URL=http://127.0.0.1:3773
# Root token the bot uses to issue its own full-access token every month (see README):
# t3 auth session issue --label app-code-bot-root --ttl 3650d --token-only \
#   --scope access:write --scope orchestration:read --scope orchestration:operate \
#   --scope settings:write --scope source-control:write
T3_ROOT_TOKEN=
# Project whose folder holds the application repositories: its id or its title (t3 project list)
T3_PROJECT_ID=
T3_PROVIDER_INSTANCE=claudeAgent
T3_MODEL=claude-sonnet-5-5
T3_EFFORT=high
# T3's data folder on this machine (its attachments/ and browser-artifacts/ hold the captures)
T3_USERDATA_DIR=/home/t3/.t3/userdata
# Folder where the agent saves Playwright captures when T3's browser tools fail.
# Must exist and be writable by the user running T3.
CAPTURES_DIR=/srv/app-code-bot/captures

# Give up and tell the asker after this long (ms)
ANSWER_TIMEOUT_MS=480000
